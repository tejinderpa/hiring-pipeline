generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  RECRUITER
  INTERVIEWER
}

enum JobStatus {
  OPEN
  CLOSED
}

enum ApplicationStage {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

enum ApplicationEventType {
  APPLICATION_CREATED
  STAGE_CHANGED
  REJECTED
  REINSTATED
  FEEDBACK_ADDED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  applicationEvents      ApplicationEvent[]       @relation("ApplicationEventActor")
  applicationAssignments ApplicationInterviewer[]
  alertDismissals        AlertDismissal[]         @relation("AlertDismissalRecruiter")
  feedback               Feedback[]
}

model JobOpening {
  id          String    @id @default(uuid())
  title       String
  department  String
  description String
  status      JobStatus @default(OPEN)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  applications Application[]
}

model Application {
  id                   String            @id @default(uuid())
  jobOpeningId         String
  candidateName        String
  candidateEmail       String
  source               String
  notes                String?
  stage                ApplicationStage  @default(APPLIED)
  rejectedFromStage    ApplicationStage?
  appliedAt            DateTime          @default(now())
  stageEnteredAt       DateTime          @default(now())
  interviewScheduledAt DateTime?
  updatedAt            DateTime          @updatedAt

  jobOpening      JobOpening               @relation(fields: [jobOpeningId], references: [id], onDelete: Restrict)
  alertDismissals AlertDismissal[]
  events          ApplicationEvent[]
  interviewers    ApplicationInterviewer[]
  feedback        Feedback[]

  @@index([jobOpeningId])
}

model AlertDismissal {
  id            String           @id @default(uuid())
  applicationId String
  stage         ApplicationStage
  dismissedBy   String
  dismissedAt   DateTime         @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  recruiter   User        @relation("AlertDismissalRecruiter", fields: [dismissedBy], references: [id], onDelete: Restrict)

  @@unique([applicationId, stage])
  @@index([dismissedBy])
}

model ApplicationInterviewer {
  applicationId String
  interviewerId String
  assignedAt    DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  interviewer User        @relation(fields: [interviewerId], references: [id], onDelete: Restrict)

  @@id([applicationId, interviewerId])
  @@index([interviewerId])
}

model Feedback {
  id            String   @id @default(uuid())
  applicationId String
  interviewerId String
  content       String
  createdAt     DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  interviewer User        @relation(fields: [interviewerId], references: [id], onDelete: Restrict)

  @@index([applicationId, createdAt])
  @@index([interviewerId])
}

model ApplicationEvent {
  id            String               @id @default(uuid())
  applicationId String
  type          ApplicationEventType
  actorId       String
  oldStage      ApplicationStage?
  newStage      ApplicationStage?
  metadata      Json?
  createdAt     DateTime             @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  actor       User        @relation("ApplicationEventActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([applicationId, createdAt])
  @@index([actorId])
}
