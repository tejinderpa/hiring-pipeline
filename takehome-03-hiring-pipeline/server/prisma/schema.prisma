generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  RECRUITER
  INTERVIEWER
}

enum JobStatus {
  OPEN
  CLOSED
}

enum ApplicationStage {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model JobOpening {
  id           String        @id @default(uuid())
  title        String
  department   String
  description  String
  status       JobStatus     @default(OPEN)
  archivedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  applications Application[]
}

model Application {
  id             String           @id @default(uuid())
  jobOpeningId   String
  candidateName  String
  candidateEmail String
  source         String
  notes          String?
  stage          ApplicationStage @default(APPLIED)
  appliedAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  jobOpening     JobOpening       @relation(fields: [jobOpeningId], references: [id], onDelete: Restrict)

  @@index([jobOpeningId])
}
