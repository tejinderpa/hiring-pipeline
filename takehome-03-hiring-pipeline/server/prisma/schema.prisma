generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  RECRUITER
  INTERVIEWER
}

enum JobStatus {
  OPEN
  CLOSED
}

enum ApplicationStage {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

enum ApplicationEventType {
  APPLICATION_CREATED
  STAGE_CHANGED
  REJECTED
  REINSTATED
  FEEDBACK_ADDED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  applicationEvents ApplicationEvent[] @relation("ApplicationEventActor")
}

model JobOpening {
  id           String        @id @default(uuid())
  title        String
  department   String
  description  String
  status       JobStatus     @default(OPEN)
  archivedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  applications Application[]
}

model Application {
  id             String           @id @default(uuid())
  jobOpeningId   String
  candidateName  String
  candidateEmail String
  source         String
  notes          String?
  stage          ApplicationStage @default(APPLIED)
  rejectedFromStage ApplicationStage?
  appliedAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  jobOpening     JobOpening       @relation(fields: [jobOpeningId], references: [id], onDelete: Restrict)
  events         ApplicationEvent[]

  @@index([jobOpeningId])
}

model ApplicationEvent {
  id            String               @id @default(uuid())
  applicationId String
  type          ApplicationEventType
  actorId       String
  oldStage      ApplicationStage?
  newStage      ApplicationStage?
  metadata      Json?
  createdAt     DateTime             @default(now())

  application   Application          @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  actor         User                 @relation("ApplicationEventActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([applicationId, createdAt])
  @@index([actorId])
}
